<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Orçamento Impressora</title>

  <style>
    body{
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;
      max-width:900px;
      margin:18px auto;
      padding:12px;
      background:#f7f7f7
    }
    h1{margin-bottom:6px}
    label{display:block;margin-top:10px;font-weight:600}
    input{
      width:100%;
      padding:8px;
      margin-top:6px;
      border:1px solid #ccc;
      border-radius:6px
    }
    .section{
      background:#fff;
      padding:12px;
      margin-top:14px;
      border-radius:8px;
      border:1px solid #eee
    }
    .btn{
      display:inline-block;
      padding:8px 12px;
      margin-top:10px;
      border-radius:6px;
      border:0;
      background:#0b76ef;
      color:#fff;
      cursor:pointer
    }
    .btn.secondary{background:#6c757d}
    .btn.history{background:#28a745}
    ul{list-style:none;padding:0}
    li{padding:10px 0;border-bottom:1px solid #eee}
  </style>
</head>

<body>

<a href="index.html" class="btn secondary">⬅️ Informática</a>
<a href="caixa.html" class="btn secondary">📘 Livro Caixa</a>

<h1>🖨️ Orçamento de Impressora</h1>

<label>Cliente</label>
<input id="cliente" placeholder="Nome do cliente">

<label>Modelo da impressora</label>
<input id="modelo" placeholder="Ex: Epson L380, HP Deskjet 2776">

<div class="section">
  <h3>Serviços</h3>
  <div id="servicos"></div>
</div>

<div class="section">
  <strong>Total:</strong>
  <span id="total">R$ 0,00</span><br>
  <button class="btn" onclick="calcular()">Calcular</button>
  <button class="btn secondary" onclick="salvarOrcamento()">Salvar Orçamento</button>
  <button class="btn history" onclick="mostrarHistorico()">Histórico</button>
</div>

<!-- MODAL HISTÓRICO -->
<div id="modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6)">
  <div style="background:#fff;margin:40px auto;padding:20px;max-width:700px;border-radius:8px">
    <h3>Histórico de Impressoras</h3>
    <ul id="listaHistorico"></ul>
    <button class="btn secondary" onclick="fecharHistorico()">Fechar</button>
  </div>
</div>

<script>
// ================= SERVIÇOS PADRÃO =================
const SERVICOS_IMPRESSORA = {
  "Instalação USB": 50,
  "Instalação Wi-Fi": 80,
  "Configuração completa": 120,
  "Limpeza de cabeçote": 80,
  "Desentupimento": 120,
  "Reset contador": 60,
  "Manutenção preventiva": 100,
  "Teste / Diagnóstico": 40
};

// ================= RENDER =================
function renderizarServicos(){
  const div = document.getElementById('servicos');
  div.innerHTML = '';
  for(const [nome,valor] of Object.entries(SERVICOS_IMPRESSORA)){
    const item = document.createElement('div');
    item.innerHTML = `
      <input type="checkbox">
      ${nome}
      <input type="number" value="${valor}" disabled>
    `;
    const chk = item.children[0];
    const inp = item.children[2];
    chk.onchange = () => {
      inp.disabled = !chk.checked;
      if(!chk.checked) inp.value = 0;
      calcular();
    };
    inp.oninput = calcular;
    div.appendChild(item);
  }
}

// ================= CALCULAR =================
function calcular(){
  let total = 0;
  document.querySelectorAll('#servicos div').forEach(d=>{
    if(d.children[0].checked){
      total += Number(d.children[2].value || 0);
    }
  });
  document.getElementById('total').innerText =
    'R$ ' + total.toLocaleString('pt-BR',{minimumFractionDigits:2});
}

// ================= SALVAR =================
function salvarOrcamento(){
  const historico = JSON.parse(localStorage.getItem('orcamentos') || '[]');

  const servicos = [];
  document.querySelectorAll('#servicos div').forEach(d=>{
    if(d.children[0].checked){
      servicos.push({
        nome: d.children[1].textContent.trim(),
        valor: Number(d.children[2].value)
      });
    }
  });

  historico.unshift({
    id: Date.now(),
    tipoServico: 'impressora',
    cliente: cliente.value,
    equipamento: modelo.value,
    servicos,
    pago: false,
    pecasCompradas: true // impressora não usa peças aqui
  });

  localStorage.setItem('orcamentos', JSON.stringify(historico));
  alert('Orçamento de impressora salvo!');
}

// ================= HISTÓRICO =================
function mostrarHistorico(){
  const historico = JSON.parse(localStorage.getItem('orcamentos') || '[]')
    .filter(o => o.tipoServico === 'impressora');

  const ul = document.getElementById('listaHistorico');
  ul.innerHTML = '';

  historico.forEach(o=>{
    const li = document.createElement('li');
    const total = o.servicos.reduce((s,i)=>s+i.valor,0);

    li.innerHTML = `
      <strong>${o.cliente || 'Cliente'}</strong><br>
      ${o.equipamento}<br>
      Total: R$ ${total.toLocaleString('pt-BR',{minimumFractionDigits:2})}
    `;

    const btnPago = document.createElement('button');
    btnPago.className = 'btn';
    btnPago.textContent = o.pago ? '✔️ Pago' : '💰 Confirmar pagamento';
    btnPago.disabled = o.pago;
    btnPago.onclick = ()=>confirmarPagamento(o.id,total);

    li.appendChild(btnPago);
    ul.appendChild(li);
  });

  modal.style.display = 'block';
}

function fecharHistorico(){
  modal.style.display = 'none';
}

// ================= CAIXA =================
function confirmarPagamento(id,total){
  if(!confirm('Confirmar pagamento?')) return;

  const caixa = JSON.parse(localStorage.getItem('livroCaixa') || '[]');
  caixa.unshift({
    id: Date.now(),
    tipo:'entrada',
    descricao:'Pagamento impressora',
    valor: total,
    data: new Date().toLocaleString('pt-BR')
  });

  localStorage.setItem('livroCaixa', JSON.stringify(caixa));

  let historico = JSON.parse(localStorage.getItem('orcamentos'));
  const o = historico.find(x=>x.id===id);
  if(o) o.pago = true;
  localStorage.setItem('orcamentos', JSON.stringify(historico));

  mostrarHistorico();
}

document.addEventListener('DOMContentLoaded', renderizarServicos);
</script>

</body>
</html>